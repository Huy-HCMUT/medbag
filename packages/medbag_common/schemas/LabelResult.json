{
  "$defs": {
    "Appearance": {
      "description": "What the label says the pill looks like, e.g. 白色圓形錠.",
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "colour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "Evidence": {
      "description": "Where a field value came from on the label.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "source": {
          "enum": [
            "text",
            "icon",
            "tick"
          ],
          "title": "Source",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "field",
        "source",
        "snippet"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Flag": {
      "description": "A problem for the family to look at before approving.",
      "properties": {
        "medicine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicine Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "code": {
          "enum": [
            "photo_unreadable",
            "missing_field",
            "impossible_dose",
            "frequency_slots_mismatch",
            "unclear",
            "fallback_used"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Flag",
      "type": "object"
    },
    "MealTiming": {
      "enum": [
        "before_meal",
        "after_meal",
        "with_meal",
        "any_time",
        "unknown"
      ],
      "title": "MealTiming",
      "type": "string"
    },
    "Medicine": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dose_per_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Per Time"
        },
        "frequency_per_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Per Day"
        },
        "slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "meal_timing": {
          "$ref": "#/$defs/MealTiming",
          "default": "unknown"
        },
        "appearance": {
          "$ref": "#/$defs/Appearance",
          "default": {
            "text": "",
            "colour": null,
            "shape": null
          }
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "unclear_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unclear Fields",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Medicine",
      "type": "object"
    },
    "Slot": {
      "enum": [
        "morning",
        "noon",
        "evening",
        "bedtime"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "description": "read_label and check_fields (Sam).",
  "properties": {
    "medicines": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Medicine"
      },
      "title": "Medicines",
      "type": "array"
    },
    "engine": {
      "enum": [
        "gemini",
        "tesseract",
        "none"
      ],
      "title": "Engine",
      "type": "string"
    },
    "flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Flag"
      },
      "title": "Flags",
      "type": "array"
    },
    "raw_text": {
      "default": "",
      "title": "Raw Text",
      "type": "string"
    }
  },
  "required": [
    "engine"
  ],
  "title": "LabelResult",
  "type": "object"
}