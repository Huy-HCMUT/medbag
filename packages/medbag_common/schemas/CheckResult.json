{
  "$defs": {
    "Box": {
      "description": "Axis-aligned box in pixels of the image it came from.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Box",
      "type": "object"
    },
    "Certainty": {
      "enum": [
        "sure",
        "unsure",
        "no_match"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "DoseRef": {
      "properties": {
        "dose_id": {
          "title": "Dose Id",
          "type": "string"
        },
        "cell": {
          "title": "Cell",
          "type": "integer"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        }
      },
      "required": [
        "dose_id",
        "cell",
        "slot",
        "due_at"
      ],
      "title": "DoseRef",
      "type": "object"
    },
    "DoseResult": {
      "enum": [
        "correct",
        "wrong_pill",
        "missing_pill",
        "extra_pill",
        "not_removed",
        "unsure",
        "cannot_check"
      ],
      "title": "DoseResult",
      "type": "string"
    },
    "Fingerprint": {
      "description": "fingerprint (Emily).",
      "properties": {
        "colour_lab": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Colour Lab",
          "type": "array"
        },
        "length_mm": {
          "title": "Length Mm",
          "type": "number"
        },
        "width_mm": {
          "title": "Width Mm",
          "type": "number"
        },
        "shape": {
          "enum": [
            "round",
            "oval",
            "capsule",
            "other"
          ],
          "title": "Shape",
          "type": "string"
        },
        "embedding": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding"
        }
      },
      "required": [
        "colour_lab",
        "length_mm",
        "width_mm",
        "shape"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "Match": {
      "description": "identify and match_fill (Emily): one pill and which medicine it is.",
      "properties": {
        "pill": {
          "$ref": "#/$defs/Pill"
        },
        "medicine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicine Id"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        },
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        }
      },
      "required": [
        "pill",
        "score",
        "certainty",
        "fingerprint"
      ],
      "title": "Match",
      "type": "object"
    },
    "Pill": {
      "description": "detect_pills (Alex): one pill on the straightened tray, with its compartment.",
      "properties": {
        "cell": {
          "title": "Cell",
          "type": "integer"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "cell",
        "box",
        "confidence"
      ],
      "title": "Pill",
      "type": "object"
    },
    "Slot": {
      "enum": [
        "morning",
        "noon",
        "evening",
        "bedtime"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "description": "check_dose (Emily).",
  "properties": {
    "dose": {
      "$ref": "#/$defs/DoseRef"
    },
    "result": {
      "$ref": "#/$defs/DoseResult"
    },
    "taken": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Match"
      },
      "title": "Taken",
      "type": "array"
    },
    "left": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Match"
      },
      "title": "Left",
      "type": "array"
    },
    "other_changed_cells": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Other Changed Cells",
      "type": "array"
    },
    "message_key": {
      "title": "Message Key",
      "type": "string"
    }
  },
  "required": [
    "dose",
    "result",
    "message_key"
  ],
  "title": "CheckResult",
  "type": "object"
}