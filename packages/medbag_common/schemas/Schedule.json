{
  "$defs": {
    "Appearance": {
      "description": "What the label says the pill looks like, e.g. 白色圓形錠.",
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "colour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "Evidence": {
      "description": "Where a field value came from on the label.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "source": {
          "enum": [
            "text",
            "icon",
            "tick"
          ],
          "title": "Source",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "field",
        "source",
        "snippet"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExpectedPill": {
      "properties": {
        "medicine_id": {
          "title": "Medicine Id",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "medicine_id",
        "count"
      ],
      "title": "ExpectedPill",
      "type": "object"
    },
    "MealTiming": {
      "enum": [
        "before_meal",
        "after_meal",
        "with_meal",
        "any_time",
        "unknown"
      ],
      "title": "MealTiming",
      "type": "string"
    },
    "Medicine": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dose_per_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose Per Time"
        },
        "frequency_per_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Per Day"
        },
        "slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "meal_timing": {
          "$ref": "#/$defs/MealTiming",
          "default": "unknown"
        },
        "appearance": {
          "$ref": "#/$defs/Appearance",
          "default": {
            "text": "",
            "colour": null,
            "shape": null
          }
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "unclear_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unclear Fields",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Medicine",
      "type": "object"
    },
    "Slot": {
      "enum": [
        "morning",
        "noon",
        "evening",
        "bedtime"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "description": "The approved schedule. Built by the server from an approved LabelResult.",
  "properties": {
    "medicines": {
      "items": {
        "$ref": "#/$defs/Medicine"
      },
      "title": "Medicines",
      "type": "array"
    },
    "cells": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/ExpectedPill"
        },
        "type": "array"
      },
      "title": "Cells",
      "type": "object"
    },
    "approved_by": {
      "title": "Approved By",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    }
  },
  "required": [
    "medicines",
    "cells",
    "approved_by",
    "approved_at"
  ],
  "title": "Schedule",
  "type": "object"
}