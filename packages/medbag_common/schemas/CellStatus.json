{
  "$defs": {
    "Box": {
      "description": "Axis-aligned box in pixels of the image it came from.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Box",
      "type": "object"
    },
    "CellState": {
      "enum": [
        "ok",
        "wrong",
        "missing",
        "extra",
        "unsure",
        "empty"
      ],
      "title": "CellState",
      "type": "string"
    },
    "Certainty": {
      "enum": [
        "sure",
        "unsure",
        "no_match"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "ExpectedPill": {
      "properties": {
        "medicine_id": {
          "title": "Medicine Id",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "medicine_id",
        "count"
      ],
      "title": "ExpectedPill",
      "type": "object"
    },
    "Fingerprint": {
      "description": "fingerprint (Emily).",
      "properties": {
        "colour_lab": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Colour Lab",
          "type": "array"
        },
        "length_mm": {
          "title": "Length Mm",
          "type": "number"
        },
        "width_mm": {
          "title": "Width Mm",
          "type": "number"
        },
        "shape": {
          "enum": [
            "round",
            "oval",
            "capsule",
            "other"
          ],
          "title": "Shape",
          "type": "string"
        },
        "embedding": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding"
        }
      },
      "required": [
        "colour_lab",
        "length_mm",
        "width_mm",
        "shape"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "Match": {
      "description": "identify and match_fill (Emily): one pill and which medicine it is.",
      "properties": {
        "pill": {
          "$ref": "#/$defs/Pill"
        },
        "medicine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicine Id"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        },
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        }
      },
      "required": [
        "pill",
        "score",
        "certainty",
        "fingerprint"
      ],
      "title": "Match",
      "type": "object"
    },
    "Pill": {
      "description": "detect_pills (Alex): one pill on the straightened tray, with its compartment.",
      "properties": {
        "cell": {
          "title": "Cell",
          "type": "integer"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "cell",
        "box",
        "confidence"
      ],
      "title": "Pill",
      "type": "object"
    }
  },
  "properties": {
    "cell": {
      "title": "Cell",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/CellState"
    },
    "expected": {
      "items": {
        "$ref": "#/$defs/ExpectedPill"
      },
      "title": "Expected",
      "type": "array"
    },
    "found": {
      "items": {
        "$ref": "#/$defs/Match"
      },
      "title": "Found",
      "type": "array"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "cell",
    "state",
    "expected",
    "found"
  ],
  "title": "CellStatus",
  "type": "object"
}