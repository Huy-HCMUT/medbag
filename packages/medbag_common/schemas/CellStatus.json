{
  "$defs": {
    "Box": {
      "description": "Axis-aligned box in pixels of the image it came from.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Box",
      "type": "object"
    },
    "CellState": {
      "enum": [
        "ok",
        "wrong",
        "missing",
        "extra",
        "unsure",
        "empty"
      ],
      "title": "CellState",
      "type": "string"
    },
    "Certainty": {
      "enum": [
        "sure",
        "unsure",
        "no_match"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "ExpectedPill": {
      "properties": {
        "medicine_id": {
          "title": "Medicine Id",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "medicine_id",
        "count"
      ],
      "title": "ExpectedPill",
      "type": "object"
    },
    "Match": {
      "description": "identify (Emily).",
      "properties": {
        "pill": {
          "$ref": "#/$defs/Pill"
        },
        "medicine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medicine Id"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "certainty": {
          "$ref": "#/$defs/Certainty"
        }
      },
      "required": [
        "pill",
        "score",
        "certainty"
      ],
      "title": "Match",
      "type": "object"
    },
    "Pill": {
      "description": "detect_pills (Alex): one pill found in one compartment crop.",
      "properties": {
        "cell": {
          "title": "Cell",
          "type": "integer"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "cell",
        "box",
        "confidence"
      ],
      "title": "Pill",
      "type": "object"
    }
  },
  "properties": {
    "cell": {
      "title": "Cell",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/CellState"
    },
    "expected": {
      "items": {
        "$ref": "#/$defs/ExpectedPill"
      },
      "title": "Expected",
      "type": "array"
    },
    "found": {
      "items": {
        "$ref": "#/$defs/Match"
      },
      "title": "Found",
      "type": "array"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "cell",
    "state",
    "expected",
    "found"
  ],
  "title": "CellStatus",
  "type": "object"
}