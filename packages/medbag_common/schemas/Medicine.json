      },
      "title": "Slots",
      "type": "array"
    },
    "meal_timing": {
      "$ref": "#/$defs/MealTiming",
      "default": "unknown"
    },
    "appearance": {
      "$ref": "#/$defs/Appearance",
      "default": {
        "text": "",
        "colour": null,
        "shape": null
      }
    },
    "purpose": {
      "default": "",
      "title": "Purpose",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "unclear_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unclear Fields",
      "type": "array"
    }
