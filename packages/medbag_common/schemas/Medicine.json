{
  "$defs": {
    "Appearance": {
      "description": "What the label says the pill looks like, e.g. 白色圓形錠.",
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "colour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "Evidence": {
      "description": "Where a field value came from on the label.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "source": {
          "enum": [
            "text",
            "icon",
            "tick"
          ],
          "title": "Source",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "field",
        "source",
        "snippet"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MealTiming": {
      "enum": [
        "before_meal",
        "after_meal",
        "with_meal",
        "any_time",
        "unknown"
      ],
      "title": "MealTiming",
      "type": "string"
    },
    "Slot": {
      "enum": [
        "morning",
        "noon",
        "evening",
        "bedtime"
      ],
      "title": "Slot",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "dose_per_time": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dose Per Time"
    },
    "frequency_per_day": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
